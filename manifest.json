{
  "$schema": "https://raw.githubusercontent.com/t8y2/dbx/plugin-sdk-v1/plugins/manifest.schema.json",
  "manifest_version": 1,
  "id": "com.bao.taf-mysql",
  "name": "TAF MySQL",
  "version": "0.1.0",
  "publisher": "bao",
  "description": "Query MySQL in TAF environments through the TgDataAsync data-access service.",
  "icon": "assets/plugin.svg",
  "engines": {
    "dbx": ">=0.5.68",
    "host_api": "1"
  },
  "entrypoints": {
    "backend": {
      "executable": "bin/dbx-plugin-taf-mysql"
    },
    "ui": {
      "root": "ui",
      "entry": "ui/index.html"
    }
  },
  "contributions": [
    {
      "type": "connection-provider",
      "id": "com.bao.taf-mysql.connection",
      "label": "TAF MySQL",
      "icon": "assets/plugin.svg",
      "database_type": "taf-mysql",
      "description": "TAF 环境 MySQL（经 TgDataAsync 服务）",
      "fields": [
        {
          "key": "display_name",
          "label": "Connection name",
          "type": "text",
          "default": "TAF MySQL",
          "binding": "name",
          "required": true
        },
        {
          "key": "servant",
          "label": "Servant",
          "type": "text",
          "default": "",
          "binding": "config",
          "required": true
        },
        {
          "key": "allow_write",
          "label": "Allow write (DML)",
          "type": "boolean",
          "default": false,
          "binding": "config"
        }
      ],
      "workbench": "com.bao.taf-mysql.workbench",
      "capabilities": ["test", "connect", "disconnect"]
    },
    {
      "type": "workbench",
      "id": "com.bao.taf-mysql.workbench",
      "label": "TAF MySQL Query",
      "description": "SQL editor and result grid for TAF MySQL connections.",
      "icon": "assets/plugin.svg"
    }
  ],
  "localizations": {
    "zh-CN": {
      "name": "TAF MySQL",
      "description": "通过 TgDataAsync 数据访问服务查询 TAF 环境 MySQL。",
      "contributions": {
        "com.bao.taf-mysql.connection": {
          "label": "TAF MySQL",
          "description": "TAF 环境 MySQL（经 TgDataAsync 服务）",
          "fields": {
            "display_name": { "label": "连接名称" },
            "servant": { "label": "Servant" },
            "allow_write": { "label": "允许写操作（INSERT/UPDATE/DELETE/REPLACE，DDL 永远禁止）" }
          }
        },
        "com.bao.taf-mysql.workbench": {
          "label": "TAF MySQL 查询",
          "description": "TAF MySQL 连接的 SQL 编辑与结果表格。"
        }
      }
    }
  }
}
